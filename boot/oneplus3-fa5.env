# OnePlus 3 Android boot-image profile.
# Derived from the known-good boot_fa5_v100_auto.img reference image.

BOOT_HEADER_VERSION=0
BOOT_PAGE_SIZE=4096
BOOT_BASE=0x80000000
BOOT_KERNEL_OFFSET=0x00008000
BOOT_RAMDISK_OFFSET=0x01000000
BOOT_SECOND_OFFSET=0x00f00000
BOOT_TAGS_OFFSET=0x00000100

# The reference appends a raw DTB to a gzip-compressed ARM64 Image.
BOOT_APPEND_DTB=1

# Safe default for early debugging. Do not carry the old pmOS root UUIDs into
# a new rootfs; provide a full replacement through BOOT_CMDLINE_OVERRIDE.
BOOT_CMDLINE='fbcon=nodefault console=tty0 pmos.debug-shell'

# Reference only; never used automatically by scripts.
REFERENCE_IMAGE_SHA256=29ccd3eb8b093b29fc44435bd6e5f98367cf3794c117f9527a6bf3c1ebc5d781
REFERENCE_CMDLINE='fbcon=nodefault console=tty0 pmos.debug-shell pmos_boot_uuid=2f202bec-765d-4062-b8b9-30a10c699e89 pmos_root_uuid=feba81cd-3eee-4971-a703-a7d80dd04b5a pmos_rootfsopts=defaults'
