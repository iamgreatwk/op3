# Experimental OnePlus 3 Android boot-image profile.
#
# This is an owner-authorized early-boot A/B profile.  It retains every field
# from the validated FA5 profile except the proposed legacy tags and ramdisk
# offsets.  Do not use it as the default profile.

source "$(dirname "${BASH_SOURCE[0]}")/oneplus3-fa5.env"

BOOT_RAMDISK_OFFSET=0x02200000
BOOT_TAGS_OFFSET=0x02000000
