#!/bin/sh
# OnePlus 3 pmOS 6.12 Wi-Fi command interface.
#
# Profiles are intentionally stored only on the persistent device filesystem:
# /newroot/etc/op3-wifi/profiles/.  Do not place credentials in this source
# tree, an initramfs, a tarball, a log, or a shell command line.

set -u

ROOT=${OP3_WIFI_ROOT:-/newroot}
STATE=${OP3_WIFI_STATE:-/run/op3-wifi}
IPV6_CONF=${OP3_WIFI_IPV6_CONF:-/proc/sys/net/ipv6/conf}
CONFIG="$ROOT/etc/op3-wifi"
PROFILES="$CONFIG/profiles"
DEFAULT="$CONFIG/default"
IFACE=${OP3_WIFI_IFACE:-wlan0}
SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")
WPA_SUPPLICANT=/usr/sbin/wpa_supplicant
WPA_CLI=/usr/sbin/wpa_cli
UDHCPC=/sbin/udhcpc
ASSOC_TIMEOUT=${OP3_WIFI_ASSOC_TIMEOUT:-90}
DHCP_WAIT=${OP3_WIFI_DHCP_WAIT:-30}

log() {
	printf '%s\n' "op3-wifi: $*" >&2
}

die() {
	log "$*"
	exit 1
}

usage() {
	cat <<'EOF'
Usage:
  wifi on | off | current | disconnect | portal
  wifi ipv6 on | off | status
  wifi connect <ssid> [passphrase] [identity]
  wifi reconnect <ssid>
  wifi list
  wifi forget <ssid> | wifi forget --all
  wifi default <ssid>

`connect` saves the profile on /newroot and makes it the boot default.  Omit
passphrase for an open network.  Supplying identity creates a PEAP profile.
Credentials are never printed by this command.
EOF
}

profile_name() {
	printf '%s' "$1" | sha256sum | awk '{print $1}'
}

profile_path() {
	printf '%s/%s.conf' "$PROFILES" "$(profile_name "$1")"
}

profile_ssid() {
	awk -F= '$1 == "# op3-wifi-ssid" { sub(/^[^=]*=/, ""); print; exit }' "$1"
}

ensure_dirs() {
	mkdir -p "$PROFILES" "$STATE" || die "cannot create Wi-Fi state directory"
	chmod 700 "$CONFIG" "$PROFILES" 2>/dev/null || true
}

wifi_on() {
	"$(dirname "$SELF")/wifi-start" || return $?
	ip link set "$IFACE" up || return $?
}

stop_client() {
	# Ask a live instance to exit before touching its control socket. A failed
	# first connection can otherwise leave /run/op3-wifi/wlan0 behind and make
	# every later wpa_supplicant invocation fail during control-interface setup.
	"$WPA_CLI" -p "$STATE" -i "$IFACE" terminate >/dev/null 2>&1 || true
	if [ -r "$STATE/wpa.pid" ]; then
		pid=$(cat "$STATE/wpa.pid")
		kill "$pid" 2>/dev/null || true
	fi
	sleep 1
	rm -f "$STATE/wpa.pid" "$STATE/udhcpc.pid" "$STATE/$IFACE"
}

start_profile() {
	profile=$1
	test -f "$profile" || die "profile not found"
	wifi_on || die "cannot bring up $IFACE"
	stop_client
	"$WPA_SUPPLICANT" -B -P "$STATE/wpa.pid" -i "$IFACE" -D nl80211 -c "$profile" ||
		die "wpa_supplicant failed"

	# A cold QCA6174 boot can spend over 30 seconds scanning weak 2.4/5 GHz
	# BSSes before the first authentication. Keep wpa_supplicant alive long
	# enough for that association so the DHCP step is not skipped.
	i=0
	while [ "$i" -lt "$ASSOC_TIMEOUT" ]; do
		if "$WPA_CLI" -p "$STATE" -i "$IFACE" status 2>/dev/null | grep -q '^wpa_state=COMPLETED$'; then
			break
		fi
		sleep 1
		i=$((i + 1))
	done
	[ "$i" -lt "$ASSOC_TIMEOUT" ] || die "association timed out"

	# Keep the DHCP client alive while a weak or roaming AP link settles. The
	# historical recovery script used -b -q for this reason; -n made the
	# 6.12 path give up after one unanswered exchange.
	if ! "$UDHCPC" -i "$IFACE" -b -q -p "$STATE/udhcpc.pid"; then
		die "DHCP client failed to start"
	fi
	i=0
	while [ "$i" -lt "$DHCP_WAIT" ]; do
		if ip -4 addr show dev "$IFACE" | grep -q 'inet '; then
			printf 'nameserver 223.5.5.5\n' > /etc/resolv.conf
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	die "DHCP lease not observed after ${DHCP_WAIT}s"
}

connect() {
	ssid=${1:?}
	passphrase=${2-}
	identity=${3-}
	ensure_dirs
	profile=$(profile_path "$ssid")
	tmp="$profile.tmp.$$"
	{
		printf '# op3-wifi-ssid=%s\n' "$ssid"
		printf 'ctrl_interface=%s\n' "$STATE"
		printf 'ap_scan=1\n'
		printf 'network={\n'
		printf '    ssid="%s"\n' "$(printf '%s' "$ssid" | sed 's/[\\"]/\\&/g')"
		printf '    scan_ssid=1\n'
		if [ -n "$identity" ]; then
			printf '    key_mgmt=WPA-EAP\n    eap=PEAP\n    phase2="auth=MSCHAPV2"\n'
			printf '    identity="%s"\n' "$(printf '%s' "$identity" | sed 's/[\\"]/\\&/g')"
			printf '    password="%s"\n' "$(printf '%s' "$passphrase" | sed 's/[\\"]/\\&/g')"
		elif [ -n "$passphrase" ]; then
			# wpa_supplicant accepts a quoted WPA passphrase and derives its PSK.
			# Do not call wpa_passphrase: /newroot can shadow it with an older
			# dynamic binary whose libcrypto is absent from the initramfs runtime.
			printf '    psk="%s"\n' "$(printf '%s' "$passphrase" | sed 's/[\\"]/\\&/g')"
		else
			printf '    key_mgmt=NONE\n'
		fi
		printf '}\n'
	} > "$tmp" || { rm -f "$tmp"; die "cannot write profile"; }
	mv "$tmp" "$profile"
	chmod 600 "$profile"
	printf '%s\n' "$ssid" > "$DEFAULT"
	chmod 600 "$DEFAULT"
	start_profile "$profile"
}

reconnect() {
	ensure_dirs
	start_profile "$(profile_path "$1")"
}

list_profiles() {
	ensure_dirs
	found=0
	for profile in "$PROFILES"/*.conf; do
		[ -f "$profile" ] || continue
		ssid=$(profile_ssid "$profile")
		[ -n "$ssid" ] || continue
		if [ -f "$DEFAULT" ] && [ "$ssid" = "$(cat "$DEFAULT")" ]; then
			printf '%s (default)\n' "$ssid"
		else
			printf '%s\n' "$ssid"
		fi
		found=1
	done
	[ "$found" = 1 ] || printf '%s\n' 'no saved Wi-Fi profiles'
}

forget() {
	ensure_dirs
	if [ "$1" = --all ]; then
		find "$PROFILES" -type f -name '*.conf' -delete
		: > "$DEFAULT"
		return
	fi
	profile=$(profile_path "$1")
	rm -f "$profile"
	if [ -f "$DEFAULT" ] && [ "$(cat "$DEFAULT")" = "$1" ]; then
		: > "$DEFAULT"
	fi
}

current() {
	if [ ! -e "/sys/class/net/$IFACE" ]; then
		printf '%s\n' "$IFACE is unavailable"
		return 1
	fi
	"$WPA_CLI" -p "$STATE" -i "$IFACE" status 2>/dev/null || true
	ip -4 addr show dev "$IFACE"
	ip -4 route show dev "$IFACE"
	ipv6_status
}

ipv6_set() {
	value=$1
	found=0

	# The all/default knobs cover interfaces created later; the per-interface
	# writes also cover links that already exist when this command runs.
	for path in "$IPV6_CONF/all/disable_ipv6" \
		"$IPV6_CONF/default/disable_ipv6" \
		"$IPV6_CONF"/*/disable_ipv6; do
		[ -e "$path" ] || continue
		printf '%s\n' "$value" > "$path" 2>/dev/null ||
			die "cannot set IPv6 state at $path"
		found=1
	done

	# A kernel without IPv6 has no sysctl tree, which already satisfies the
	# default-off policy. Enabling IPv6 must report that it is unavailable.
	if [ "$found" = 0 ] && [ "$value" = 0 ]; then
		return 0
	fi
	[ "$found" = 1 ] || die "IPv6 sysctl is unavailable"
}

ipv6_status() {
	if [ ! -d "$IPV6_CONF" ]; then
		printf '%s\n' 'ipv6=unavailable'
		return 1
	fi

	all=$(cat "$IPV6_CONF/all/disable_ipv6" 2>/dev/null || printf '?')
	default=$(cat "$IPV6_CONF/default/disable_ipv6" 2>/dev/null || printf '?')
	iface=$(cat "$IPV6_CONF/$IFACE/disable_ipv6" 2>/dev/null || printf '?')
	case $all in
		0) state=on ;;
		1) state=off ;;
		*) state=unknown ;;
	esac
	printf 'ipv6=%s all=%s default=%s %s=%s\n' \
		"$state" "$all" "$default" "$IFACE" "$iface"
}

portal() {
	# A captive portal commonly intercepts this HTTP request.  links follows the
	# redirect and gives the user an interactive login page when it is available.
	command -v links >/dev/null 2>&1 || die "links is not installed"
	links "${OP3_WIFI_PORTAL_URL:-http://connectivitycheck.gstatic.com/generate_204}"
}

auto() {
	ensure_dirs
	[ -s "$DEFAULT" ] || exit 0
	reconnect "$(cat "$DEFAULT")"
}

case ${1-} in
	on) wifi_on ;;
	off) stop_client; ip link set "$IFACE" down 2>/dev/null || true ;;
	disconnect) stop_client ;;
	current) current ;;
	ipv6)
		[ "$#" = 2 ] || { usage; exit 2; }
		case "$2" in
			on) ipv6_set 0 ;;
			off) ipv6_set 1 ;;
			status) ipv6_status ;;
			*) usage; exit 2 ;;
		esac
		;;
	portal) portal ;;
	connect) [ "$#" -ge 2 ] && [ "$#" -le 4 ] || { usage; exit 2; }; connect "$2" "${3-}" "${4-}" ;;
	reconnect) [ "$#" = 2 ] || { usage; exit 2; }; reconnect "$2" ;;
	list) [ "$#" = 1 ] || { usage; exit 2; }; list_profiles ;;
	forget) [ "$#" = 2 ] || { usage; exit 2; }; forget "$2" ;;
	default) [ "$#" = 2 ] || { usage; exit 2; }; ensure_dirs; test -f "$(profile_path "$2")" || die "profile not found"; printf '%s\n' "$2" > "$DEFAULT" ;;
	auto) [ "$#" = 1 ] || exit 2; auto ;;
	-help|--help|help|'') usage ;;
	*) usage; exit 2 ;;
esac
