From bd462e1011b486ce3612ad89d91cc0f3891101ca Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Sat, 29 Aug 2026 00:00:32 +0800
Subject: [PATCH 2/2] arm64: dts: qcom: add S6E3FA5 panel for v6.16 test

---
 .../boot/dts/qcom/msm8996-oneplus-common.dtsi | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi b/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi
index 63ab56465..22fcead48 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi
@@ -190,10 +190,36 @@ &mdss_dsi0 {
 	vdda-supply = <&vreg_l2a_1p25>;
 	vcca-supply = <&vreg_l22a_3p0>;
 	status = "okay";
+
+	panel: panel@0 {
+		reg = <0>;
+		compatible = "samsung,s6e3fa5";
+		vddio-supply = <&vreg_l18a_3p3>;
+		vdda-supply = <&vreg_s5a_2p15>;
+
+		enable-gpios = <&tlmm 26 0>;
+		reset-gpios = <&tlmm 8 0>;
+		disp-te-gpios = <&tlmm 11 0>;
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&mdss_dsi_active &mdss_te_active>;
+		pinctrl-1 = <&mdss_dsi_suspend &mdss_te_suspend>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
 };
 
 &mdss_dsi0_out {
 	data-lanes = <0 1 2 3>;
+
+	remote-endpoint = <&panel_in>;
 };
 
 &mdss_dsi0_phy {
-- 
2.53.0

