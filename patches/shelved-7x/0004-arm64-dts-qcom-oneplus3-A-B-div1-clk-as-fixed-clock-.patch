From 77b11ffd06fed3eaea31adcf38b57e105cb0b6f6 Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Thu, 27 Aug 2026 21:10:20 +0800
Subject: [PATCH 4/6] arm64: dts: qcom: oneplus3: A/B div1-clk as fixed-clock
 (DTS boot fix)

---
 arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi b/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi
index e852dc1391..0af2de70da 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi
@@ -32,12 +32,14 @@ chosen {
 
 	clocks {
 		div1_mclk: div1-clk {
-			compatible = "gpio-gate-clock";
-			pinctrl-names = "default";
-			pinctrl-0 = <&audio_mclk>;
+			/* A/B: switch gpio-gate-clock -> fixed-clock to match the
+			 * bootable v100 DTB. The gpio-gate-clock node referencing
+			 * pm8994_gpios/rpmcc is the prime suspect for the early
+			 * fastboot return. */
+			compatible = "fixed-clock";
 			#clock-cells = <0>;
-			clocks = <&rpmcc RPM_SMD_DIV_CLK1>;
-			enable-gpios = <&pm8994_gpios 15 GPIO_ACTIVE_HIGH>;
+			clock-frequency = <24576000>;
+			clock-output-names = "divclk1";
 		};
 
 		divclk4: div4-clk {
-- 
2.53.0

