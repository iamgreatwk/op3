From 9de073b8b144565db524c885eb7252335aaa933a Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Thu, 3 Sep 2026 17:34:15 +0800
Subject: [PATCH 13/31] ASoC: q6asm: trace capture pointer accounting

---
 sound/soc/qcom/qdsp6/q6asm-dai.c | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/sound/soc/qcom/qdsp6/q6asm-dai.c b/sound/soc/qcom/qdsp6/q6asm-dai.c
index 0466ab2e318c80699424437f4bfd93ffa3e1e4c5..a02a6caccfd7d798de6d6c259974faec04b17e54 100644
--- a/sound/soc/qcom/qdsp6/q6asm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6asm-dai.c
@@ -58,6 +58,8 @@ struct q6asm_dai_rtd {
 	unsigned int pcm_size;
 	unsigned int pcm_count;
 	unsigned int pcm_irq_pos;       /* IRQ position */
+	unsigned int capture_period_log_count;
+	unsigned int capture_pointer_log_count;
 	unsigned int periods;
 	unsigned int bytes_sent;
 	unsigned int bytes_received;
@@ -200,6 +202,15 @@ static void event_handler(uint32_t opcode, uint32_t token,
 		break;
 		}
 	case ASM_CLIENT_EVENT_DATA_READ_DONE:
+		if (prtd->capture_period_log_count < 16) {
+			dev_info(substream->pcm->card->dev,
+				 "capture PERIOD[%u] token=%u irq_before=%u irq_after=%u bytes=%u\n",
+				 prtd->capture_period_log_count, token,
+				 prtd->pcm_irq_pos,
+				 prtd->pcm_irq_pos + prtd->pcm_count,
+				 prtd->pcm_count);
+			prtd->capture_period_log_count++;
+		}
 		prtd->pcm_irq_pos += prtd->pcm_count;
 		snd_pcm_period_elapsed(substream);
 		if (prtd->state == Q6ASM_STREAM_RUNNING)
@@ -233,6 +244,8 @@ static int q6asm_dai_prepare(struct snd_soc_component *component,
 
 	prtd->pcm_count = snd_pcm_lib_period_bytes(substream);
 	prtd->pcm_irq_pos = 0;
+	prtd->capture_period_log_count = 0;
+	prtd->capture_pointer_log_count = 0;
 	/* rate and channels are sent to audio driver */
 	if (prtd->state) {
 		/* clear the previous setup if any  */
@@ -462,10 +475,22 @@ static snd_pcm_uframes_t q6asm_dai_pointer(struct snd_soc_component *component,
 
 	struct snd_pcm_runtime *runtime = substream->runtime;
 	struct q6asm_dai_rtd *prtd = runtime->private_data;
+	unsigned int irq_pos = prtd->pcm_irq_pos;
+	bool wrapped = irq_pos >= prtd->pcm_size;
 
-	if (prtd->pcm_irq_pos >= prtd->pcm_size)
+	if (wrapped)
 		prtd->pcm_irq_pos = 0;
 
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE &&
+	    prtd->capture_pointer_log_count < 16) {
+		dev_info(substream->pcm->card->dev,
+			 "capture POINTER[%u] irq_before=%u wrapped=%u irq_after=%u frames=%lu\n",
+			 prtd->capture_pointer_log_count, irq_pos, wrapped,
+			 prtd->pcm_irq_pos,
+			 (unsigned long)bytes_to_frames(runtime, prtd->pcm_irq_pos));
+		prtd->capture_pointer_log_count++;
+	}
+
 	return bytes_to_frames(runtime, (prtd->pcm_irq_pos));
 }
 
