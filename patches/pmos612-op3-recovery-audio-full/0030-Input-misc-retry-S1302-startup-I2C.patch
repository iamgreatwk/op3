From c15090406a2a57b3f3d8c14c79c93f929a8ef06a Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Sun, 6 Sep 2026 14:30:47 +0800
Subject: [PATCH 30/31] Input: misc: retry S1302 startup I2C

---
 drivers/input/misc/op3-capkey-s1302.c | 35 ++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/drivers/input/misc/op3-capkey-s1302.c b/drivers/input/misc/op3-capkey-s1302.c
index 0edeb1fcfc0127dd5404356e80e386426593c37d..b152bf2917dfe9f9276d3ad4b6eff05017fb0e6e 100644
--- a/drivers/input/misc/op3-capkey-s1302.c
+++ b/drivers/input/misc/op3-capkey-s1302.c
@@ -20,6 +20,8 @@
 #define S1302_KEYS_PAGE		0x02
 #define S1302_KEYS_REGISTER	0x00
 #define S1302_KEY_MASK		GENMASK(1, 0)
+#define S1302_PROBE_RETRIES	8
+#define S1302_PROBE_RETRY_DELAY_MS	25
 
 struct s1302_capkey {
 	struct i2c_client *client;
@@ -77,6 +79,37 @@ static int s1302_read_keys(struct s1302_capkey *key)
 	return state & S1302_KEY_MASK;
 }
 
+static bool s1302_retryable_error(int ret)
+{
+	return ret == -ENXIO || ret == -EREMOTEIO || ret == -EIO;
+}
+
+static int s1302_read_initial_keys(struct s1302_capkey *key)
+{
+	int attempt;
+	int ret;
+
+	/*
+	 * On the integrated OP3 image the controller can still be completing its
+	 * reset/power-up sequence when the I2C client is first probed.  Treat the
+	 * resulting NACK as a transient startup condition, but keep normal IRQ
+	 * reads single-shot so a real runtime bus error is not hidden.
+	 */
+	for (attempt = 0; ; attempt++) {
+		ret = s1302_read_keys(key);
+		if (ret >= 0)
+			return ret;
+		if (attempt >= S1302_PROBE_RETRIES ||
+		    !s1302_retryable_error(ret))
+			return ret;
+
+		dev_warn(&key->client->dev,
+			 "controller not ready (%d), retry %d/%d\n", ret,
+			 attempt + 1, S1302_PROBE_RETRIES);
+		msleep(S1302_PROBE_RETRY_DELAY_MS);
+	}
+}
+
 static void s1302_report_state(struct s1302_capkey *key, u8 state)
 {
 	input_report_key(key->input, KEY_APPSELECT, state & BIT(0));
@@ -89,7 +122,7 @@ static irqreturn_t s1302_irq_thread(int irq, void *data)
 	struct s1302_capkey *key = data;
 	int state;
 
-	state = s1302_read_keys(key);
+	state = s1302_read_initial_keys(key);
 	if (state < 0) {
 		dev_warn_ratelimited(&key->client->dev,
 					"failed to read key state: %d\n", state);
