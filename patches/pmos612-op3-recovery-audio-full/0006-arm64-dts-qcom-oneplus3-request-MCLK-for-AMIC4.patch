From 0ba6a5392f169d9f5cb0dd860b9bcc076516d5d3 Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Wed, 2 Sep 2026 18:41:24 +0800
Subject: [PATCH 06/31] arm64: dts: qcom: oneplus3: request MCLK for AMIC4

---
 arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts b/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts
index 4fee37f41728f494d9d5d88374805aa8fd0559ed..927f8cc9440029abda687adb6ef28c986df69ca5 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts
@@ -68,9 +68,10 @@ &sound {
 	 * otherwise rejects the whole card while parsing any unresolved endpoint.
 	 */
 	audio-routing = "RX_BIAS", "MCLK",
-			"AMIC2", "MIC BIAS2",
-			"AMIC4", "MIC BIAS1",
-			"AMIC5", "MIC BIAS3";
+		"AMIC2", "MIC BIAS2",
+		"AMIC4", "MIC BIAS1",
+		"MIC BIAS1", "MCLK",
+		"AMIC5", "MIC BIAS3";
 
 	mm4-dai-link { status = "disabled"; };
 	mm5-dai-link { status = "disabled"; };
