From 4a486e2ea7e46622d68ae039a2ccf2db909ab99d Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Sun, 6 Sep 2026 14:31:01 +0800
Subject: [PATCH 31/31] Input: misc: keep S1302 IRQ reads single-shot

---
 drivers/input/misc/op3-capkey-s1302.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/input/misc/op3-capkey-s1302.c b/drivers/input/misc/op3-capkey-s1302.c
index b152bf2917dfe9f9276d3ad4b6eff05017fb0e6e..04072a6efdb8d6fafd14d0da7698ac00b0b32f0d 100644
--- a/drivers/input/misc/op3-capkey-s1302.c
+++ b/drivers/input/misc/op3-capkey-s1302.c
@@ -122,7 +122,7 @@ static irqreturn_t s1302_irq_thread(int irq, void *data)
 	struct s1302_capkey *key = data;
 	int state;
 
-	state = s1302_read_initial_keys(key);
+	state = s1302_read_keys(key);
 	if (state < 0) {
 		dev_warn_ratelimited(&key->client->dev,
 					"failed to read key state: %d\n", state);
@@ -177,7 +177,7 @@ static int s1302_capkey_probe(struct i2c_client *client)
 		usleep_range(20000, 30000);
 	}
 
-	state = s1302_read_keys(key);
+	state = s1302_read_initial_keys(key);
 	if (state < 0)
 		return dev_err_probe(dev, state, "failed to read initial key state\n");
 	key->state = state & S1302_KEY_MASK;
