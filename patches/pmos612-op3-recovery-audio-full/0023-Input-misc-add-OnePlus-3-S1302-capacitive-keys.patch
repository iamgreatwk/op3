--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -968,4 +968,15 @@ config INPUT_STPMIC1_ONKEY
 	  To compile this driver as a module, choose M here: the
 	  module will be called stpmic1_onkey.
 
+config INPUT_OP3_S1302_CAPKEY
+	tristate "OnePlus 3 Synaptics S1302 capacitive keys"
+	depends on I2C
+	depends on GPIOLIB
+	depends on REGULATOR
+	help
+	  Say Y here to support the two OnePlus 3 capacitive chin keys
+	  connected to the Synaptics S1302 controller.  The driver reads
+	  the controller's legacy RMI page-2 key-state register and reports
+	  KEY_APPSELECT and KEY_BACK.
+
 endif
