index 0000000000000000000000000000000000000000..0edeb1fcfc0127dd5404356e80e386426593c37d
--- /dev/null
+++ b/drivers/input/misc/op3-capkey-s1302.c
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OnePlus 3 Synaptics S1302 capacitive chin keys
+ *
+ * The S1302 is a separate controller from the display touchscreen.  Its
+ * legacy firmware exposes the key state at page 2, register 0, with bit 0
+ * for the left/recent key and bit 1 for the right/back key.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#define S1302_PAGE_SELECT	0xff
+#define S1302_KEYS_PAGE		0x02
+#define S1302_KEYS_REGISTER	0x00
+#define S1302_KEY_MASK		GENMASK(1, 0)
+
+struct s1302_capkey {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct regulator *vdd;
+	struct regulator *vio;
+	struct gpio_desc *reset;
+	u8 state;
+};
+
+static void s1302_disable_regulator(void *data)
+{
+	regulator_disable(data);
+}
+
+static int s1302_enable_regulator(struct device *dev, const char *name,
+					  struct regulator **supply)
+{
+	int ret;
+
+	*supply = devm_regulator_get_optional(dev, name);
+	if (IS_ERR(*supply)) {
+		ret = PTR_ERR(*supply);
+		if (ret == -ENODEV) {
+			*supply = NULL;
+			return 0;
+		}
+		return dev_err_probe(dev, ret, "failed to get %s supply\n", name);
+	}
+
+	ret = regulator_enable(*supply);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable %s supply\n", name);
+
+	return devm_add_action_or_reset(dev, s1302_disable_regulator, *supply);
+}
+
+static int s1302_read_keys(struct s1302_capkey *key)
+{
+	int state;
+	int ret;
+
+	ret = i2c_smbus_write_byte_data(key->client, S1302_PAGE_SELECT,
+					S1302_KEYS_PAGE);
+	if (ret < 0)
+		return ret;
+
+	state = i2c_smbus_read_byte_data(key->client, S1302_KEYS_REGISTER);
+	ret = i2c_smbus_write_byte_data(key->client, S1302_PAGE_SELECT, 0x00);
+	if (state < 0)
+		return state;
+	if (ret < 0)
+		return ret;
+
+	return state & S1302_KEY_MASK;
+}
+
+static void s1302_report_state(struct s1302_capkey *key, u8 state)
+{
+	input_report_key(key->input, KEY_APPSELECT, state & BIT(0));
+	input_report_key(key->input, KEY_BACK, state & BIT(1));
+	input_sync(key->input);
+}
+
+static irqreturn_t s1302_irq_thread(int irq, void *data)
+{
+	struct s1302_capkey *key = data;
+	int state;
+
+	state = s1302_read_keys(key);
+	if (state < 0) {
+		dev_warn_ratelimited(&key->client->dev,
+					"failed to read key state: %d\n", state);
+		return IRQ_HANDLED;
+	}
+
+	state &= S1302_KEY_MASK;
+	if (state != key->state) {
+		if ((state ^ key->state) & BIT(0))
+			input_report_key(key->input, KEY_APPSELECT, state & BIT(0));
+		if ((state ^ key->state) & BIT(1))
+			input_report_key(key->input, KEY_BACK, state & BIT(1));
+		input_sync(key->input);
+		key->state = state;
+	}
+
+	return IRQ_HANDLED;
+}
+
+static int s1302_capkey_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s1302_capkey *key;
+	int state;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA))
+		return dev_err_probe(dev, -EOPNOTSUPP,
+				    "adapter lacks SMBus byte-data support\n");
+
+	key = devm_kzalloc(dev, sizeof(*key), GFP_KERNEL);
+	if (!key)
+		return -ENOMEM;
+
+	key->client = client;
+	i2c_set_clientdata(client, key);
+
+	ret = s1302_enable_regulator(dev, "vdd", &key->vdd);
+	if (ret)
+		return ret;
+	ret = s1302_enable_regulator(dev, "vio", &key->vio);
+	if (ret)
+		return ret;
+
+	key->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(key->reset))
+		return dev_err_probe(dev, PTR_ERR(key->reset),
+				    "failed to get reset GPIO\n");
+	if (key->reset) {
+		usleep_range(10000, 15000);
+		gpiod_set_value_cansleep(key->reset, 0);
+		usleep_range(20000, 30000);
+	}
+
+	state = s1302_read_keys(key);
+	if (state < 0)
+		return dev_err_probe(dev, state, "failed to read initial key state\n");
+	key->state = state & S1302_KEY_MASK;
+
+	key->input = devm_input_allocate_device(dev);
+	if (!key->input)
+		return -ENOMEM;
+
+	key->input->name = "op3-capkey-s1302";
+	key->input->id.bustype = BUS_I2C;
+	input_set_capability(key->input, EV_KEY, KEY_APPSELECT);
+	input_set_capability(key->input, EV_KEY, KEY_BACK);
+
+	ret = input_register_device(key->input);
+	if (ret)
+		return ret;
+
+	s1302_report_state(key, key->state);
+
+	ret = devm_request_threaded_irq(dev, client->irq, NULL,
+				s1302_irq_thread, IRQF_ONESHOT,
+				"op3-capkey-s1302", key);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request IRQ\n");
+
+	dev_info(dev, "S1302 capacitive keys ready (irq=%d)\n", client->irq);
+	return 0;
+}
+
+static const struct of_device_id s1302_capkey_of_match[] = {
+	{ .compatible = "oneplus,s1302-capkey" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s1302_capkey_of_match);
+
+static const struct i2c_device_id s1302_capkey_id[] = {
+	{ "op3-capkey-s1302", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, s1302_capkey_id);
+
+static struct i2c_driver s1302_capkey_driver = {
+	.probe = s1302_capkey_probe,
+	.id_table = s1302_capkey_id,
+	.driver = {
+		.name = "op3-capkey-s1302",
+		.of_match_table = s1302_capkey_of_match,
+	},
+};
+module_i2c_driver(s1302_capkey_driver);
+
+MODULE_AUTHOR("Agent OS");
+MODULE_DESCRIPTION("OnePlus 3 Synaptics S1302 capacitive keys");
+MODULE_LICENSE("GPL");
