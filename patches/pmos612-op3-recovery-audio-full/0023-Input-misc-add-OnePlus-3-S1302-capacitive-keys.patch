+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/oneplus,s1302-capkey.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OnePlus 3 Synaptics S1302 capacitive keys
+
+maintainers:
+  - Agent OS <agent-os@example.invalid>
+
+description: |
+  The OnePlus 3 uses a Synaptics S1302 controller on a dedicated I2C bus
+  for the left/recent and right/back capacitive keys below the display.
+  Key state is read from RMI page 2, register 0.
+
+allOf:
+  - $ref: /schemas/i2c/i2c-device.yaml#
+
+properties:
+  compatible:
+    const: oneplus,s1302-capkey
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description: Active low controller reset
+
+  vdd-supply: true
+  vio-supply: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
