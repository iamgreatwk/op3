From f1c19271bba43adb609d5eaaf8613f884a7ff3a1 Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Thu, 3 Sep 2026 17:10:55 +0800
Subject: [PATCH] ASoC: q6asm: trace initial capture read submissions

---
 sound/soc/qcom/qdsp6/q6asm.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/q6asm.c b/sound/soc/qcom/qdsp6/q6asm.c
index fc2c461161ce..9b0d904c6543 100644
--- a/sound/soc/qcom/qdsp6/q6asm.c
+++ b/sound/soc/qcom/qdsp6/q6asm.c
@@ -265,6 +265,7 @@ struct audio_client {
 	void *priv;
 	uint32_t io_mode;
 	u32 capture_read_done_log_count;
+	u32 capture_read_submit_log_count;
 	struct apr_device *adev;
 	struct mutex cmd_lock;
 	spinlock_t lock;
@@ -1469,6 +1470,8 @@ int q6asm_read(struct audio_client *ac, uint32_t stream_id)
 	struct audio_buffer *ab;
 	struct apr_pkt *pkt;
 	unsigned long flags;
+	u32 submit_count = 0;
+	bool log_read_submit = false;
 	int pkt_size;
 	int rc = 0;
 	void *p;
@@ -1493,6 +1496,10 @@ int q6asm_read(struct audio_client *ac, uint32_t stream_id)
 	read->buf_size = ab->size;
 	read->seq_id = port->dsp_buf;
 	pkt->hdr.token = port->dsp_buf;
+	if (ac->capture_read_submit_log_count < 16) {
+		submit_count = ac->capture_read_submit_log_count++;
+		log_read_submit = true;
+	}
 
 	port->dsp_buf++;
 
@@ -1500,6 +1507,10 @@ int q6asm_read(struct audio_client *ac, uint32_t stream_id)
 		port->dsp_buf = 0;
 
 	spin_unlock_irqrestore(&ac->lock, flags);
+	if (log_read_submit)
+		dev_info(ac->dev,
+			 "capture READ_SUBMIT[%u] token=%u addr=%pa size=%u\n",
+			 submit_count, pkt->hdr.token, &ab->phys, read->buf_size);
 	rc = apr_send_pkt(ac->adev, pkt);
 	if (rc == pkt_size)
 		rc = 0;
-- 
2.53.0

