From 44429af1bfab351c5046fdd9d00a1140b7586b1e Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Sat, 5 Sep 2026 23:52:20 +0800
Subject: [PATCH] arm64: dts: msm8996-oneplus: route speaker through q6routing

---
 arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi b/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi
index 760b71e7fe22..26abf690bc18 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8996-oneplus-common.dtsi
@@ -801,6 +801,10 @@ cpu {
 			sound-dai = <&q6afedai QUATERNARY_MI2S_RX>;
 		};
 
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
 		codec {
 			sound-dai = <&tfa9890_amp>;
 		};
