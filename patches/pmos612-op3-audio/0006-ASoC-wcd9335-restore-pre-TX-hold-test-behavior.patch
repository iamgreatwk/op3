From d39beb8f34780b0f2ba7631cd6250f78f73ce913 Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Thu, 3 Sep 2026 16:43:55 +0800
Subject: [PATCH 6/7] ASoC: wcd9335: restore pre-TX-hold test behavior

The valid OP3-AUDIO-010 run rejects the TX-hold release hypothesis.
Restore the preceding codec behavior before the next isolated Q6ASM
diagnostic.

Signed-off-by: kai <249905534@qq.com>

diff --git a/sound/soc/codecs/wcd9335.c b/sound/soc/codecs/wcd9335.c
index e2dd570fcab5..dbba5b03b936 100644
--- a/sound/soc/codecs/wcd9335.c
+++ b/sound/soc/codecs/wcd9335.c
@@ -2856,15 +2856,6 @@ static int wcd9335_codec_enable_dec(struct snd_soc_dapm_widget *w,
 						0x10, 0x00);
 		snd_soc_component_write(comp, tx_gain_ctl_reg,
 			      snd_soc_component_read(comp, tx_gain_ctl_reg));
-		/*
-		 * ADC power-up holds its AMIC input while the decimator is
-		 * configured.  Release that hold only after the selected TX path
-		 * has been unmuted and its gain latched.
-		 */
-		amic_n = wcd9335_codec_find_amic_input(comp, decimator);
-		if (amic_n)
-			wcd9335_codec_set_tx_hold(comp,
-				WCD9335_ANA_AMIC1 + amic_n - 1, false);
 		break;
 	case SND_SOC_DAPM_PRE_PMD:
 		hpf_coff_freq = (snd_soc_component_read(comp, dec_cfg_reg) &
-- 
