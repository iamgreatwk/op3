From 57b9a78bdc2efd0eb5aea77981cace6172beb80c Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Sat, 5 Sep 2026 12:36:59 +0800
Subject: [PATCH] ASoC: q6asm: enforce no-rewinds on effective runtime

---
 sound/soc/qcom/qdsp6/q6asm-dai.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/sound/soc/qcom/qdsp6/q6asm-dai.c b/sound/soc/qcom/qdsp6/q6asm-dai.c
index ce8e52276b37..aa03829fdefd 100644
--- a/sound/soc/qcom/qdsp6/q6asm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6asm-dai.c
@@ -109,6 +109,7 @@ static const struct snd_pcm_hardware q6asm_dai_hardware_capture = {
 static const struct snd_pcm_hardware q6asm_dai_hardware_playback = {
 	.info =                 (SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_BATCH |
 				SNDRV_PCM_INFO_BLOCK_TRANSFER |
+				SNDRV_PCM_INFO_NO_REWINDS |
 				SNDRV_PCM_INFO_MMAP_VALID |
 				SNDRV_PCM_INFO_INTERLEAVED |
 				SNDRV_PCM_INFO_PAUSE | SNDRV_PCM_INFO_RESUME),
