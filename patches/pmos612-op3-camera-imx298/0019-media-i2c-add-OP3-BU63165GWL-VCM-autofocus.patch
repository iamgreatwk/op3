diff --git a/drivers/media/i2c/bu63165gwl.c b/drivers/media/i2c/bu63165gwl.c
new file mode 100644
index 000000000000..b6ca460074c7
--- /dev/null
+++ b/drivers/media/i2c/bu63165gwl.c
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ROHM BU63165GWL voice-coil actuator found in the OnePlus 3 IMX298 module.
+ *
+ * The OP3 downstream camera stack programs this actuator through four
+ * byte-register writes for every lens position:
+ *
+ *   0xf0 = 0x90, 0xf1 = 0x00, 0xf2 = position[15:8],
+ *   0xf3 = position[7:0]
+ *
+ * The sequence and the 10-bit position range are preserved here from the
+ * downstream actuator configuration.  The actual infinity/macro calibration
+ * is a separate EEPROM property and is intentionally not guessed here.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+
+#define BU63165GWL_NAME			"bu63165gwl"
+#define BU63165GWL_MAX_FOCUS_POS	1023
+#define BU63165GWL_FOCUS_STEPS		1
+#define BU63165GWL_POWER_DELAY_US	1000
+
+struct bu63165gwl {
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_subdev sd;
+	struct v4l2_ctrl *focus;
+	struct regulator *vaf;
+	struct mutex lock;
+	bool active;
+};
+
+static inline struct bu63165gwl *to_bu63165gwl(struct v4l2_ctrl *ctrl)
+{
+	return container_of(ctrl->handler, struct bu63165gwl, ctrls);
+}
+
+static inline struct bu63165gwl *sd_to_bu63165gwl(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct bu63165gwl, sd);
+}
+
+static int bu63165gwl_write_byte(struct bu63165gwl *vcm, u8 reg, u8 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&vcm->sd);
+	u8 buf[2] = { reg, val };
+	int ret;
+
+	ret = i2c_master_send(client, buf, sizeof(buf));
+	if (ret == sizeof(buf))
+		return 0;
+	if (ret >= 0)
+		ret = -EIO;
+
+	dev_err(&client->dev, "write reg 0x%02x failed: %d\n", reg, ret);
+	return ret;
+}
+
+static int bu63165gwl_write_position(struct bu63165gwl *vcm, u16 position)
+{
+	int ret;
+
+	/* This is the OP3-specific BU63165GWL command sequence. */
+	ret = bu63165gwl_write_byte(vcm, 0xf0, 0x90);
+	if (ret)
+		return ret;
+
+	ret = bu63165gwl_write_byte(vcm, 0xf1, 0x00);
+	if (ret)
+		return ret;
+
+	ret = bu63165gwl_write_byte(vcm, 0xf2, position >> 8);
+	if (ret)
+		return ret;
+
+	ret = bu63165gwl_write_byte(vcm, 0xf3, position & 0xff);
+	if (ret)
+		return ret;
+
+	dev_dbg(vcm->sd.dev,
+		"position=%u sequence=f0:90 f1:00 f2:%02x f3:%02x\n",
+		position, position >> 8, position & 0xff);
+	return 0;
+}
+
+static int bu63165gwl_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct bu63165gwl *vcm = to_bu63165gwl(ctrl);
+	int ret = 0;
+
+	if (ctrl->id != V4L2_CID_FOCUS_ABSOLUTE)
+		return -EINVAL;
+
+	mutex_lock(&vcm->lock);
+	if (!vcm->active)
+		ret = -EPIPE;
+	else
+		ret = bu63165gwl_write_position(vcm, ctrl->val);
+	mutex_unlock(&vcm->lock);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops bu63165gwl_ctrl_ops = {
+	.s_ctrl = bu63165gwl_set_ctrl,
+};
+
+static int bu63165gwl_power_on(struct bu63165gwl *vcm)
+{
+	struct device *dev = vcm->sd.dev;
+	int ret;
+
+	if (vcm->active)
+		return 0;
+
+	ret = regulator_enable(vcm->vaf);
+	if (ret) {
+		dev_err(dev, "failed to enable VAF 2.8V: %d\n", ret);
+		return ret;
+	}
+
+	usleep_range(BU63165GWL_POWER_DELAY_US,
+			     BU63165GWL_POWER_DELAY_US + 500);
+	vcm->active = true;
+	dev_info(dev, "VAF enabled voltage=%d\n",
+		 regulator_get_voltage(vcm->vaf));
+
+	return 0;
+}
+
+static int bu63165gwl_power_off(struct bu63165gwl *vcm)
+{
+	int ret;
+
+	if (!vcm->active)
+		return 0;
+
+	ret = regulator_disable(vcm->vaf);
+	if (ret)
+		return ret;
+
+	vcm->active = false;
+	return 0;
+}
+
+static int bu63165gwl_open(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_fh *fh)
+{
+	struct bu63165gwl *vcm = sd_to_bu63165gwl(sd);
+
+	return pm_runtime_resume_and_get(vcm->sd.dev);
+}
+
+static int bu63165gwl_close(struct v4l2_subdev *sd,
+				    struct v4l2_subdev_fh *fh)
+{
+	pm_runtime_put(sd->dev);
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops bu63165gwl_internal_ops = {
+	.open = bu63165gwl_open,
+	.close = bu63165gwl_close,
+};
+
+static const struct v4l2_subdev_ops bu63165gwl_subdev_ops = { };
+
+static int bu63165gwl_init_controls(struct bu63165gwl *vcm)
+{
+	struct v4l2_ctrl_handler *hdl = &vcm->ctrls;
+
+	v4l2_ctrl_handler_init(hdl, 1);
+	vcm->focus = v4l2_ctrl_new_std(hdl, &bu63165gwl_ctrl_ops,
+				       V4L2_CID_FOCUS_ABSOLUTE, 0,
+				       BU63165GWL_MAX_FOCUS_POS,
+				       BU63165GWL_FOCUS_STEPS, 0);
+	if (hdl->error) {
+		dev_err(vcm->sd.dev, "failed to initialize controls: %d\n",
+			hdl->error);
+		return hdl->error;
+	}
+
+	vcm->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static int bu63165gwl_probe(struct i2c_client *client)
+{
+	struct bu63165gwl *vcm;
+	int ret;
+
+	vcm = devm_kzalloc(&client->dev, sizeof(*vcm), GFP_KERNEL);
+	if (!vcm)
+		return -ENOMEM;
+
+	mutex_init(&vcm->lock);
+	vcm->vaf = devm_regulator_get(&client->dev, "vaf");
+	if (IS_ERR(vcm->vaf))
+		return dev_err_probe(&client->dev, PTR_ERR(vcm->vaf),
+				     "failed to get VAF regulator\n");
+
+	v4l2_i2c_subdev_init(&vcm->sd, client, &bu63165gwl_subdev_ops);
+	vcm->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	vcm->sd.internal_ops = &bu63165gwl_internal_ops;
+	vcm->sd.entity.function = MEDIA_ENT_F_LENS;
+
+	ret = bu63165gwl_init_controls(vcm);
+	if (ret)
+		goto err_ctrls;
+
+	ret = media_entity_pads_init(&vcm->sd.entity, 0, NULL);
+	if (ret)
+		goto err_ctrls;
+
+	ret = v4l2_async_register_subdev(&vcm->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(&client->dev);
+	pm_runtime_enable(&client->dev);
+	pm_runtime_idle(&client->dev);
+
+	dev_info(&client->dev,
+		 "BU63165GWL ready at CCI address 0x%02x, focus range 0..%u\n",
+		 client->addr, BU63165GWL_MAX_FOCUS_POS);
+	return 0;
+
+err_entity:
+	media_entity_cleanup(&vcm->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&vcm->ctrls);
+	return ret;
+}
+
+static void bu63165gwl_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct bu63165gwl *vcm = sd_to_bu63165gwl(sd);
+
+	pm_runtime_disable(&client->dev);
+	mutex_lock(&vcm->lock);
+	bu63165gwl_power_off(vcm);
+	mutex_unlock(&vcm->lock);
+	v4l2_async_unregister_subdev(sd);
+	v4l2_ctrl_handler_free(&vcm->ctrls);
+	media_entity_cleanup(&sd->entity);
+}
+
+static int __maybe_unused bu63165gwl_runtime_suspend(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct bu63165gwl *vcm = sd_to_bu63165gwl(sd);
+	int ret;
+
+	mutex_lock(&vcm->lock);
+	ret = bu63165gwl_power_off(vcm);
+	mutex_unlock(&vcm->lock);
+	return ret;
+}
+
+static int __maybe_unused bu63165gwl_runtime_resume(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct bu63165gwl *vcm = sd_to_bu63165gwl(sd);
+	int ret;
+
+	mutex_lock(&vcm->lock);
+	ret = bu63165gwl_power_on(vcm);
+	mutex_unlock(&vcm->lock);
+	return ret;
+}
+
+static const struct dev_pm_ops bu63165gwl_pm_ops = {
+	SET_RUNTIME_PM_OPS(bu63165gwl_runtime_suspend,
+			   bu63165gwl_runtime_resume, NULL)
+};
+
+static const struct of_device_id bu63165gwl_of_match[] = {
+	{ .compatible = "rohm,bu63165gwl" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, bu63165gwl_of_match);
+
+static const struct i2c_device_id bu63165gwl_id[] = {
+	{ BU63165GWL_NAME },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, bu63165gwl_id);
+
+static struct i2c_driver bu63165gwl_i2c_driver = {
+	.driver = {
+		.name = BU63165GWL_NAME,
+		.pm = &bu63165gwl_pm_ops,
+		.of_match_table = bu63165gwl_of_match,
+	},
+	.probe = bu63165gwl_probe,
+	.remove = bu63165gwl_remove,
+	.id_table = bu63165gwl_id,
+};
+module_i2c_driver(bu63165gwl_i2c_driver);
+
+MODULE_DESCRIPTION("ROHM BU63165GWL VCM driver");
+MODULE_AUTHOR("OnePlus 3 mainline recovery project");
+MODULE_LICENSE("GPL");
