Subject: [PATCH] media: i2c: add OP3 BU63165GWL VCM autofocus

---
 .../bindings/media/i2c/rohm,bu63165gwl.yaml   |  45 +++
 .../bindings/media/i2c/sony,imx298.yaml       |   4 +
 arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts |   9 +
 drivers/media/i2c/Kconfig                     |  12 +
 drivers/media/i2c/Makefile                    |   1 +
 drivers/media/i2c/bu63165gwl.c                | 311 ++++++++++++++++++
 6 files changed, 382 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/rohm,bu63165gwl.yaml
 create mode 100644 drivers/media/i2c/bu63165gwl.c

diff --git a/Documentation/devicetree/bindings/media/i2c/rohm,bu63165gwl.yaml b/Documentation/devicetree/bindings/media/i2c/rohm,bu63165gwl.yaml
new file mode 100644
index 000000000000..e14e456d6e69
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/rohm,bu63165gwl.yaml
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/rohm,bu63165gwl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ROHM BU63165GWL voice-coil lens actuator
+
+maintainers:
+  - Kai <249905534@qq.com>
+
+description:
+  The ROHM BU63165GWL is the voice-coil lens actuator paired with the
+  OnePlus 3 rear Sony IMX298 sensor.  It is controlled over the OP3 CCI
+  bus and requires the dedicated 2.8 V autofocus supply.
+
+properties:
+  compatible:
+    const: rohm,bu63165gwl
+
+  reg:
+    maxItems: 1
+
+  vaf-supply:
+    description: 2.8 V supply for the autofocus actuator.
+
+required:
+  - compatible
+  - reg
+  - vaf-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera-lens@1c {
+            compatible = "rohm,bu63165gwl";
+            reg = <0x1c>;
+            vaf-supply = <&vreg_l23a_2p8>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/media/i2c/sony,imx298.yaml b/Documentation/devicetree/bindings/media/i2c/sony,imx298.yaml
index d0894cea859f..269cea08109c 100644
--- a/Documentation/devicetree/bindings/media/i2c/sony,imx298.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx298.yaml
@@ -48,6 +48,10 @@ properties:
     description: Sensor autofocus power-control GPIO, active high.
     maxItems: 1
 
+  lens-focus:
+    description: Phandle to the voice-coil lens actuator.
+    $ref: /schemas/types.yaml#/definitions/phandle
+
   port:
     $ref: /schemas/graph.yaml#/$defs/port-base
     additionalProperties: false
diff --git a/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts b/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts
index c44df4d0f75c..f6546d523540 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts
@@ -156,6 +156,13 @@ &cci_i2c0 {
 	/* The OP3 Android camera stack selects CCI fast mode (400 kHz). */
 	clock-frequency = <400000>;
 
+	/* Rear IMX298 voice-coil actuator from the original OP3 camera stack. */
+	bu63165gwl: camera-lens@1c {
+		compatible = "rohm,bu63165gwl";
+		reg = <0x1c>;
+		vaf-supply = <&vreg_l23a_2p8>;
+	};
+
 	/* Rear Sony IMX298 at the OP3's CCI0 address 0x1a. */
 	imx298: camera-sensor@1a {
 		compatible = "sony,imx298";
@@ -177,6 +184,8 @@ imx298: camera-sensor@1a {
 		pinctrl-1 = <&op3_cam_rear_sleep>, <&op3_cam_vaf_sleep>,
 			<&op3_cam_mclk0_sleep>;
 
+		lens-focus = <&bu63165gwl>;
+
 		port {
 			op3_imx298_ep: endpoint {
 				data-lanes = <0 1 2 3>;
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 790e9104d911..3e9c65d945d6 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -777,6 +777,18 @@ config VIDEO_AK7375
 	  capability. This is designed for linear control of
 	  voice coil motors, controlled via I2C serial interface.
 
+config VIDEO_BU63165GWL
+	tristate "ROHM BU63165GWL lens voice coil support"
+	depends on I2C && VIDEO_DEV
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_ASYNC
+	help
+	  This is a driver for the ROHM BU63165GWL voice-coil
+	  actuator used by the OnePlus 3 rear IMX298 camera.
+	  The driver exposes the standard V4L2 absolute-focus
+	  control and uses the OP3 four-register write sequence.
+
 config VIDEO_DW9714
 	tristate "DW9714 lens voice coil support"
 	depends on I2C && VIDEO_DEV
