 static inline struct imx298 *to_imx298(struct v4l2_subdev *sd)
 {
 	return container_of(sd, struct imx298, sd);
@@ -316,8 +490,193 @@ static int imx298_init_regulators(struct imx298 *imx298)
 				       imx298->supplies);
 }
 
-/* No streaming operations are exposed until a clean IMX298 mode is added. */
-static const struct v4l2_subdev_ops imx298_subdev_ops = { };
+static int imx298_write_mode(struct imx298 *imx298)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(imx298_mode_1476x834); i++) {
+		ret = regmap_write(imx298->regmap,
+				   imx298_mode_1476x834[i].address,
+				   imx298_mode_1476x834[i].value);
+		if (ret) {
+			dev_err(imx298->dev,
+				"mode write failed reg=0x%04x value=0x%02x rc=%d\n",
+				imx298_mode_1476x834[i].address,
+				imx298_mode_1476x834[i].value, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int imx298_start_streaming(struct imx298 *imx298)
+{
+	int ret;
+
+	ret = imx298_write_mode(imx298);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(imx298->regmap, IMX298_REG_MODE_SELECT,
+			   IMX298_MODE_STREAMING);
+	if (ret) {
+		dev_err(imx298->dev, "stream-on write failed rc=%d\n", ret);
+		return ret;
+	}
+
+	usleep_range(10000, 12000);
+	imx298->streaming = true;
+	dev_info(imx298->dev, "streaming started mode=%ux%u code=RG10\n",
+		 IMX298_MODE_WIDTH, IMX298_MODE_HEIGHT);
+
+	return 0;
+}
+
+static int imx298_stop_streaming(struct imx298 *imx298)
+{
+	int ret;
+
+	ret = regmap_write(imx298->regmap, IMX298_REG_MODE_SELECT,
+			   IMX298_MODE_STANDBY);
+	if (ret)
+		dev_err(imx298->dev, "stream-off write failed rc=%d\n", ret);
+	else
+		dev_info(imx298->dev, "streaming stopped\n");
+
+	imx298->streaming = false;
+	return ret;
+}
+
+static int imx298_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx298 *imx298 = to_imx298(sd);
+	struct v4l2_subdev_state *state;
+	int ret = 0;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+	if (!state)
+		return -EINVAL;
+
+	if (!enable) {
+		if (!imx298->streaming)
+			goto unlock;
+
+		ret = imx298_stop_streaming(imx298);
+		pm_runtime_mark_last_busy(imx298->dev);
+		pm_runtime_put(imx298->dev);
+		goto unlock;
+	}
+
+	if (imx298->streaming) {
+		ret = 0;
+		goto unlock;
+	}
+
+	ret = pm_runtime_resume_and_get(imx298->dev);
+	if (ret < 0)
+		goto unlock;
+
+	ret = imx298_start_streaming(imx298);
+	if (ret)
+		pm_runtime_put_sync(imx298->dev);
+
+unlock:
+	v4l2_subdev_unlock_state(state);
+	return ret;
+}
+
+static int imx298_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->pad != 0 || code->index != 0)
+		return -EINVAL;
+
+	code->code = IMX298_MBUS_CODE;
+	return 0;
+}
+
+static int imx298_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->pad != 0 || fse->index != 0 ||
+	    fse->code != IMX298_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = IMX298_MODE_WIDTH;
+	fse->max_width = IMX298_MODE_WIDTH;
+	fse->min_height = IMX298_MODE_HEIGHT;
+	fse->max_height = IMX298_MODE_HEIGHT;
+	return 0;
+}
+
+static void imx298_fill_format(struct v4l2_mbus_framefmt *format)
+{
+	format->width = IMX298_MODE_WIDTH;
+	format->height = IMX298_MODE_HEIGHT;
+	format->code = IMX298_MBUS_CODE;
+	format->field = V4L2_FIELD_NONE;
+	format->colorspace = V4L2_COLORSPACE_RAW;
+	format->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	format->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	format->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx298_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct imx298 *imx298 = to_imx298(sd);
+	struct v4l2_mbus_framefmt *format;
+
+	if (fmt->pad != 0)
+		return -EINVAL;
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE && imx298->streaming)
+		return -EBUSY;
+
+	format = v4l2_subdev_state_get_format(state, fmt->pad);
+	imx298_fill_format(format);
+	fmt->format = *format;
+
+	return 0;
+}
+
+static int imx298_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *format;
+
+	format = v4l2_subdev_state_get_format(state, 0);
+	imx298_fill_format(format);
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops imx298_video_ops = {
+	.s_stream = imx298_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx298_pad_ops = {
+	.enum_mbus_code = imx298_enum_mbus_code,
+	.enum_frame_size = imx298_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx298_set_fmt,
+};
+
+static const struct v4l2_subdev_ops imx298_subdev_ops = {
+	.video = &imx298_video_ops,
+	.pad = &imx298_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx298_internal_ops = {
+	.init_state = imx298_init_state,
+};
+
+static const struct media_entity_operations imx298_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
 
 static int imx298_probe(struct i2c_client *client)
 {
@@ -368,8 +727,10 @@ static int imx298_probe(struct i2c_client *client)
 				    "failed to initialize register map\n");
 
 	v4l2_i2c_subdev_init(&imx298->sd, client, &imx298_subdev_ops);
+	imx298->sd.internal_ops = &imx298_internal_ops;
 	imx298->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
 	imx298->sd.dev = dev;
+	imx298->sd.entity.ops = &imx298_entity_ops;
 	imx298->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
 	imx298->pad.flags = MEDIA_PAD_FL_SOURCE;
 
@@ -419,10 +780,14 @@ static int imx298_probe(struct i2c_client *client)
 	if (ret)
 		goto err_power_off;
 
+	ret = v4l2_subdev_init_finalize(&imx298->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
 	ret = v4l2_async_register_subdev_sensor(&imx298->sd);
 	if (ret) {
 		dev_err(dev, "failed to register V4L2 sensor: %d\n", ret);
-		goto err_entity_cleanup;
+		goto err_subdev_cleanup;
 	}
 
 	pm_runtime_set_active(dev);
@@ -431,6 +796,8 @@ static int imx298_probe(struct i2c_client *client)
 
 	return 0;
 
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&imx298->sd);
 err_entity_cleanup:
 	media_entity_cleanup(&imx298->sd.entity);
 err_power_off:
@@ -444,6 +811,7 @@ static void imx298_remove(struct i2c_client *client)
 	struct imx298 *imx298 = to_imx298(sd);
 
 	v4l2_async_unregister_subdev(&imx298->sd);
+	v4l2_subdev_cleanup(&imx298->sd);
 	media_entity_cleanup(&imx298->sd.entity);
 
 	pm_runtime_disable(&client->dev);
