From f50ebce60238b29aa3e47cbccd52631602b32c39 Mon Sep 17 00:00:00 2001
From: kai <249905534@qq.com>
Date: Tue, 8 Sep 2026 21:22:24 +0800
Subject: [PATCH 3/8] arm64: dts: qcom: enable OP3 IMX298 probe


diff --git a/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts b/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts
index 927f8cc94400..e8d9cf9a1706 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-oneplus3.dts
@@ -55,6 +55,37 @@ &panel {
        compatible = "samsung,s6e3fa5";
 };
 
+/* OP3 15801 rear camera wiring: MCLK0/GPIO13 and reset/XCLR/GPIO30. */
+&tlmm {
+	op3_cam_mclk0_default: op3-cam-mclk0-default-state {
+		pins = "gpio13";
+		function = "cam_mclk";
+		drive-strength = <16>;
+		bias-disable;
+	};
+
+	op3_cam_mclk0_sleep: op3-cam-mclk0-sleep-state {
+		pins = "gpio13";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	op3_cam_rear_default: op3-cam-rear-default-state {
+		pins = "gpio30";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
+
+	op3_cam_rear_sleep: op3-cam-rear-sleep-state {
+		pins = "gpio30";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
 /*
  * The q6asm provider declares only MultiMedia1 through MultiMedia3.  The
  * generic MSM8996 OnePlus card also declares MultiMedia4 through MultiMedia16;
@@ -87,3 +118,51 @@ &sound {
 	mm15-dai-link { status = "disabled"; };
 	mm16-dai-link { status = "disabled"; };
 };
+
+&camss {
+	status = "okay";
+
+	ports {
+		port@0 {
+			reg = <0>;
+			op3_cam_csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&op3_imx298_ep>;
+			};
+		};
+	};
+};
+
+&cci {
+	status = "okay";
+};
+
+&cci_i2c0 {
+	clock-frequency = <1000000>;
+
+	/* Rear Sony IMX298 at the OP3's CCI0 address 0x1a. */
+	imx298: camera-sensor@1a {
+		compatible = "sony,imx298";
+		reg = <0x1a>;
+
+		vdig-supply = <&vreg_l3a_1p1>;
+		vio-supply = <&vreg_s4a_1p8>;
+		vana-supply = <&vreg_l17a_2p6>;
+
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+		clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		clock-frequency = <24000000>;
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&op3_cam_rear_default>, <&op3_cam_mclk0_default>;
+		pinctrl-1 = <&op3_cam_rear_sleep>, <&op3_cam_mclk0_sleep>;
+
+		port {
+			op3_imx298_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&op3_cam_csiphy0_ep>;
+			};
+		};
+	};
+};
