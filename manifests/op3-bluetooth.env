# Overlay for the OP3 Bluetooth userspace/runtime experiment.
#
# scripts/prepare-op3-buildroot.sh sources the integrated recovery manifest
# first, then this file when OP3_BUILDROOT_MANIFEST points here. Keeping the
# Buildroot lock separate prevents an untested Bluetooth profile from changing
# the accepted recovery manifest.

BUILDROOT_CONFIG_SOURCE_SHA256=d9d81b1303397362fd80831c4f13b2a6f3ad50352abdaeb653079c161cef0bc3
BUILDROOT_RECOVERY_TARGET_DIR=out/buildroot-op3-bluetooth/target
BUILDROOT_INITRAMFS_ARTIFACT=artifacts/initrd-op3-recovery-buildroot-bluetooth.cpio.gz
