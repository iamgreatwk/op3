# OnePlus 3 recovery integrated rebuild lock.
#
# Paths are relative to the top-level project repository. The kernel is a
# separate Git repository under source/ and is locked independently below.
# PROJECT_SOURCE_COMMIT is the last top-level source commit before this lock
# file; the verifier accepts descendants on the assigned project branch so the
# lock file itself can be committed without a self-referential hash.

MANIFEST_VERSION=1

PROJECT_BRANCH=agent/implementation/recovery-browser-001
PROJECT_SOURCE_COMMIT=eef720c3ea979aef00bbe3657b9afba925ea3c29

KERNEL_REMOTE_URL=https://gitlab.com/msm8996-mainline/linux.git
KERNEL_BASE_BRANCH=msm8996-stable-6.12.y
KERNEL_BASE_COMMIT=67b0bbc3cbf46bae712a2606a43361756fcbd829
KERNEL_SOURCE_DIR=source/linux-pmos-msm8996-6.12-recovery-audio-full
KERNEL_BRANCH=agent/implementation/recovery-browser-audio-full-001
KERNEL_COMMIT=4a486e2ea7e46622d68ae039a2ccf2db909ab99d
KERNEL_TREE=dd6476a68184e7293b05a7e962f0536f0d54048a
KERNEL_PATCH_SERIES_DIR=patches/pmos612-op3-recovery-audio-full
KERNEL_PATCH_COUNT=31

KERNEL_OUTPUT_DIR=out/pmos-msm8996-6.12-recovery-audio-full-s1302-retry
KERNEL_CONFIG_REL=.config
KERNEL_CONFIG_SOURCE=kernel/configs/oneplus3-recovery-audio-full.config
KERNEL_IMAGE_REL=arch/arm64/boot/Image.gz
KERNEL_DTB_REL=arch/arm64/boot/dts/qcom/msm8996-oneplus3.dtb

CONFIG_SHA256=c3da142eb257c5b0b501f24b91b74c0dba58a16ac6af252f054a4f14540baeb3
KERNEL_CONFIG_SOURCE_SHA256=c3da142eb257c5b0b501f24b91b74c0dba58a16ac6af252f054a4f14540baeb3
KERNEL_IMAGE_SHA256=5c89259d9340071c9c8684d361042482ca25c8f76b2de4d33cdacf2105f78861
KERNEL_DTB_SHA256=264f981678c1dd8d1d9a52f2db6e2130a0ebccbb9f4485ab8740784f73806db7

# Proprietary ath10k inputs are deliberately external to GitHub. The restore
# script verifies these hashes before copying them into the restored worktree.
ATH10K_FIRMWARE_REL=extfw/ath10k/QCA6174/hw3.0/firmware-6.bin
ATH10K_FIRMWARE_SHA256=04d3bad5efa3f9fbe3ba53fd3e25fa9b0585ed227eea8111303b4e08861f979d
ATH10K_BOARD_REL=extfw/ath10k/QCA6174/hw3.0/board-2.bin
ATH10K_BOARD_SHA256=66e83dde1c9af535df1fcd17c72971a96a263357300e921b358d35a353227d60

BOOT_PROFILE=boot/oneplus3-fa5.env
RECOVERY_INITRD=artifacts/initrd-op3-recovery-browser-audio.cpio.gz
RECOVERY_INITRD_SHA256=c0f0a2b45a5b9b1e6d34f25c5a20d19521203794c779b9460b9d0e5ec5a0055b
BOOT_IMAGE=artifacts/boot-oneplus3-pmos612-recovery-audio-s1302-retry.img
BOOT_IMAGE_SHA256=899c54963a59fd871538579c09f67a09558a13e8d83d26ed9647224f35b91a49

KERNEL_ARCH=arm64
KERNEL_CROSS_COMPILE=aarch64-linux-gnu-
KERNEL_CC=aarch64-linux-gnu-gcc-11
KERNEL_TARGETS="Image.gz dtbs"

# Buildroot is an external source repository. These values describe the
# reproducible userspace input; the generated target/ and dl/ directories stay
# outside GitHub.
BUILDROOT_REMOTE_URL=https://gitlab.com/buildroot.org/buildroot.git
BUILDROOT_COMMIT=679b9ead7620bbf193620d1ebf56f53c1764d37a
BUILDROOT_SOURCE_DIR=source/buildroot
BUILDROOT_CONFIG_NAME=op3_recovery_defconfig
BUILDROOT_CONFIG_SOURCE=buildroot/op3-recovery.defconfig
BUILDROOT_CONFIG_SOURCE_SHA256=8e054e72e554b0710d0cd72b8005e1fbfb7ceff030ad364697ff715b19901292
BUILDROOT_RECOVERY_TARGET_DIR=out/buildroot-op3-recovery/target
BUILDROOT_WIFI_MODULES_ROOT=artifacts/op3-wifi-modules-root
BUILDROOT_BROWSER_CONFIG_NAME=op3_browser_defconfig
BUILDROOT_BROWSER_CONFIG_SOURCE=buildroot/op3-browser.defconfig
BUILDROOT_BROWSER_CONFIG_SOURCE_SHA256=ba925ac66a7348b7c9b93060177f9e22d82598bcd82d3c6b66340f4b4389c411
BUILDROOT_BROWSER_TARGET_DIR=out/buildroot-op3-egl/target
BUILDROOT_COG_PATCH_SOURCE_DIR=buildroot/package-patches/cog

# The historical pmOS ramdisk is an external binary input. It is extracted
# from the known-good v100 boot image and verified before any overlay is made.
REFERENCE_BOOT_IMAGE_SHA256=29ccd3eb8b093b29fc44435bd6e5f98367cf3794c117f9527a6bf3c1ebc5d781
REFERENCE_INITRD_SHA256=c3358a1cadb747996ddaa492e636827f2d72974040e8fd40d81f8a213e676366

# CJK font is fetched from the Ubuntu package archive and checked before being
# copied into the browser bundle.
WQY_FONT_SHA256=2420e8078af796b19a3f6ef13de527a1a91c1e7171eea115926c614ced1009b3

# All external inputs can be retained below one directory outside the
# checkout. Set OP3_EXTERNAL_INPUTS to that directory when rebuilding.
EXTERNAL_INPUTS_DIR_NAME=op3-recovery-external-inputs
NON_HLOS_SHA512=c0f3f908e237202003d9b2fe4071e2800bdcdae180e8311fbc0671478fcd63aba5a3fe5ab5d297010c12c232501f05f31141fc39a44c5b86ac2b56016f553a7f
