# MSM8996 early-boot-critical drivers as built-in.
#
# The known-good pmOS 6.3.1 v74 configuration (extracted from Image-v74 via
# IKCONFIG) sets nearly every MSM8996 platform driver to =y.  Linux 7.2's
# defconfig leaves the same drivers as modules (=m).  The OnePlus 3 diagnostic
# initramfs carries only a static /init and NO kernel modules, so any driver
# left as a module is never loaded.  Several of these are probed early during
# platform bring-up (display/mmcc clocks, ADSP remoteproc firmware loading,
# UFS/USB PHYs, watchdog); leaving them unloaded stalls early init and the
# device returns to fastboot before any output.
#
# Keep every early-boot-relevant MSM8996 platform driver built-in.  This
# mirrors the bootable v74 layout while staying a single-layer configuration
# change on the Linux 7.2 tree.

# --- Clocks / display: multimedia clock controller (DTS: mdss/mmss references) ---
# Note: CONFIG_QCOM_RPMCC does not exist in Linux 7.2; the MSM8996 RPM clock
# controller (qcom,rpmcc-msm8996) is served by CONFIG_QCOM_CLK_SMD_RPM, which
# is already =y.
CONFIG_MSM_MMCC_8996=y

# --- Watchdog / reset / SPMI ---
CONFIG_QCOM_WDT=y
CONFIG_RESET_QCOM_PDC=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_COINCELL=y

# --- Remoteproc: ADSP/SLPI firmware loading ---
# v74 (bootable 6.3.1) has these built-in. Linux 7.2 leaves them modules.
# They are now forced built-in to mirror v74 exactly.  NOTE: built-in probe
# requires the firmware files (adsp.mbn/slpi.mbn/mba.mbn) present in the
# initramfs; therefore this fragment MUST be tested with the v100 full
# initramfs (artifacts/reference-initrd.img), NOT the minimal/ACM initramfs.
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_APR=y

# --- PHYs: UFS / USB (early storage/USB bring-up) ---
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_QMP_PCIE_8996=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_USB_SS=y

# --- RTC / misc ---
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_BACKLIGHT_QCOM_WLED=y

# --- Haptics / input (optional but built-in in the bootable v74) ---
CONFIG_INPUT_QCOM_SPMI_HAPTICS=y
CONFIG_INPUT_GPIO_VIBRA=y
CONFIG_INPUT_PWM_VIBRA=y
