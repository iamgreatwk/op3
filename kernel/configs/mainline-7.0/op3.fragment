# OnePlus 3 (MSM8996 / S6E3FA5 panel) fragment for Linux 7.0-rc1 boot test.
# Derivation: verbatim copy of the gemini-mainline-linux project's
# config/gemini.fragment (proven to boot mainline 7.0 on the same SoC,
# Xiaomi Mi 5 / MSM8996), with exactly ONE functional change:
#   panel driver DRM_PANEL_JDI_R63452 -> DRM_PANEL_SAMSUNG_S6E3FA5
# Base: arm64 defconfig. EFI off. VA 48-bit. DRM_MSM=m (built-in probe
# hangs on this platform). g_serial + U_SERIAL_CONSOLE for the early
# USB console. Reference: docs/handoff/pmos612-browser-cog.md.
# MSM8996 Kryo boots with 48-bit VA. defconfig is 52-bit — will not boot.
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_VA_BITS=48
CONFIG_ARM64_4K_PAGES=y
# Initramfs (UFS probe can lag; ginkgo-style switch_root)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
# Serial / fbcon — printk on panel once MSM fbdev registers (DRM is a module).
# boot.img cmdline must end with console=tty0 (gemini build-bootimg.sh).
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# UFS rootfs (sda15)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
# LK is not EFI. Stub/earlycon can hang before USB.
# CONFIG_EFI is not set
# USB gadget: built-in g_serial console (configfs ACM in initramfs steals
# the UDC and never produces ttyGS0 data — gemini lesson #7).
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_CONFIGFS_FS=y
CONFIG_TYPEC=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_QMP_PCIE_8996=y
# Display: MSM DRM as a module. Built-in probe races LK splash and can
# hang (USB up, ACM empty, screen stuck on FASTBOOT) — gemini lesson.
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_COMMAND_DB=y
# CONFIG_QCOM_LLCC is not set
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_MDP5=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_DPU is not set
# CONFIG_DRM_MSM_DP is not set
# CONFIG_DRM_MSM_HDMI is not set
CONFIG_DRM_PANEL_SAMSUNG_S6E3FA5=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
# Touch: Synaptics RMI4 (OP3 S3508 / gemini S3330, same driver)
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_I2C=y
CONFIG_I2C_QUP=y
CONFIG_SPI=y
CONFIG_SPI_QUP=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
# Qualcomm MSM8996
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_MSM8996=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_MSM_GCC_8996=y
CONFIG_QCOM_CLK_RPM=y
CONFIG_MSM_MMCC_8996=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_MSM8996=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SCM=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_REMOTEPROC=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_TSENS=y
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
# msm8996 idle-states use PSCI (cpu-sleep-0)
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
# Reboot to fastboot: PON spare (mode-bootloader). Do NOT add pshold@4ab000
# or ioremap IMEM — both hang msm8996 boards (gemini lesson).
CONFIG_POWER_RESET_MSM=y
CONFIG_POWER_RESET_QCOM_PON=y
# CONFIG_POWER_RESET_QCOM_IMEM is not set
CONFIG_QCOM_WDT=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_POWER_SUPPLY=y
CONFIG_EXTCON=y
# Sound later; modules so first boot does not depend on them
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_MSM8996=m
CONFIG_SND_SOC_QDSP6=m
# Debug
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
