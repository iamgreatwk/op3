# Buildroot defconfig for the default OnePlus 3 recovery payload.
#
# This is the default profile for the final recovery image. It deliberately
# does not select Mesa/Freedreno EGL/GLES, Weston DRM, WPE WebKit, Cog, or
# WPEWebDriver. Those packages remain available through the optional
# buildroot/op3-browser.defconfig profile.

BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# Test-device bootstrap access for dropbear. This is a fixed crypt( SHA-512 )
# hash for the lab password; never reuse that password outside bring-up.
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD="$$6$$op3recovery$$F7VxL8Dp3dj0m3solXDvy5ANBpEVcIiK8v0yeTsVfd.sH7DEfntcz1fDl9ZG03wrtUldrPCVYxBftwPuXZJSD1"

# Keep a TAR for the optional persistent /newroot payload and make the CPIO
# image the canonical, self-built initramfs used by pack-boot.sh.
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_FULL=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

# Recovery audio capture/playback uses TinyALSA on the persistent target.
BR2_PACKAGE_TINYALSA=y
BR2_PACKAGE_TINYALSA_TOOLS=y

# The direct-DRM recovery binary and its browser-session helpers are compiled
# and installed by the project-owned Buildroot package.
BR2_PACKAGE_OP3_RECOVERY=y
BR2_PACKAGE_OP3_INITRAMFS=y

# Wi-Fi userspace is built into the recovery target. The post-build hook also
# copies the matching kernel module closure from OP3_WIFI_MODULES_ROOT.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_ROOTFS_POST_BUILD_SCRIPT="board/oneplus3/recovery/post-build.sh"

# Small helpers for device-side diagnostics.
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_STRACE=y
