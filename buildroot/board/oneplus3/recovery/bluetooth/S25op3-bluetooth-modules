#!/bin/sh

# Load the Bluetooth module closure before Buildroot's DBus and bluetoothd
# scripts. The OP3 DTS exposes the QCA6174 controller through serdev on the
# BT UART, so hci_uart must be registered after btqca and before userspace
# starts looking for hci0.

case "$1" in
	start)
		rc=0
		for module in bluetooth btqca hci_uart; do
			modprobe "$module" || rc=1
		done
		exit "$rc"
		;;
	stop)
		rmmod hci_uart 2>/dev/null || true
		rmmod btqca 2>/dev/null || true
		rmmod bluetooth 2>/dev/null || true
		;;
esac

exit 0
