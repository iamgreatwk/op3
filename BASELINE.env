# The only default bring-up baseline. Read this file from every project script.
# This is the validated OnePlus 3 product line: pmOS MSM8996 v6.12.1 LTS.
TARGET_KERNEL_VERSION=6.12
TARGET_KERNEL_RELEASE=6.12.1
TARGET_KERNEL_TAG=msm8996-stable-6.12.y
TARGET_KERNEL_TREE=pmos-msm8996
TARGET_KERNEL_REMOTE=https://gitlab.com/msm8996-mainline/linux.git
TARGET_KERNEL_COMMIT=67b0bbc3cbf46bae712a2606a43361756fcbd829
TARGET_KERNEL_SOURCE_DIR=source/linux-pmos-msm8996-6.12
TARGET_KERNEL_OUTPUT_DIR=out/linux-pmos-msm8996-6.12-defconfig
TARGET_DEVICE=oneplus3
TARGET_SOC=msm8996

# Legacy reference only; it must never be selected by default.
LEGACY_KERNEL_VERSION=6.3.1
LEGACY_KERNEL_TREE=pmos-msm8996
LEGACY_KERNEL_REMOTE=https://gitlab.com/msm8996-mainline/linux.git
LEGACY_KERNEL_COMMIT=9895e7e38b829a810b9f75d1f98c9e4349ae454a

# Linux 7.x is archived/shelved research, not a fallback baseline.
SHELVED_KERNEL_SERIES=7.x

HOST_TARGET='Ubuntu 26.04 LTS x86_64'
CROSS_GCC=aarch64-linux-gnu-gcc-11
CROSS_COMPILE=aarch64-linux-gnu-
